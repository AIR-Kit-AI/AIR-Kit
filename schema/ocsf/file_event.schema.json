{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://airkit.local/schema/ocsf/file_event.schema.json",
  "title": "FileEvent",
  "description": "A filesystem event: create, modify, delete, or rename, typically from EDR or a file integrity monitor.",
  "type": "object",
  "required": ["event_class", "time", "uid", "action", "file", "host"],
  "properties": {
    "event_class": { "const": "file_event" },
    "uid": { "type": "string" },
    "time": { "type": "string", "format": "date-time" },
    "action": {
      "type": "string",
      "enum": ["create", "modify", "delete", "rename", "read"]
    },
    "file": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "previous_path": { "type": "string", "description": "Populated for rename actions." },
        "hash_sha256": { "type": "string" },
        "size_bytes": { "type": "integer" }
      }
    },
    "process": {
      "type": "object",
      "properties": {
        "pid": { "type": "integer" },
        "name": { "type": "string" }
      },
      "description": "The process responsible for the file operation, if the source correlates one."
    },
    "host": {
      "type": "object",
      "required": ["hostname"],
      "properties": {
        "hostname": { "type": "string" },
        "ip": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["adapter", "vendor"],
      "properties": {
        "adapter": { "type": "string" },
        "vendor": { "type": "string" },
        "native_id": { "type": "string" }
      }
    },
    "raw": { "type": "object" }
  }
}
